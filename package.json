{
  "name": "atlas-putovanja",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas putovanja — Android aplikacija (Capacitor).",
  "scripts": {
    "build:android": "node scripts/build.js",
    "android:init": "npx cap add android && npx capacitor-assets generate --android",
    "android:sync": "npm run build:android && npx cap sync android",
    "android:open": "npx cap open android",
    "capacitor:copy:after": "node scripts/admob-manifest.js"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "d3": "7.8.5",
    "jsvectormap": "1.5.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
